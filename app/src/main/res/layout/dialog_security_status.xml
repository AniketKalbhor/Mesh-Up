<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- TESLA Information Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TESLA Authentication"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/md_theme_primary"/>

    <TextView
        android:id="@+id/teslaInfoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="14sp"/>

    <ProgressBar
        android:id="@+id/teslaProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"/>

    <!-- Hop Count Information Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hop Count Protection"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/md_theme_primary"/>

    <TextView
        android:id="@+id/hopCountInfoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:textSize="14sp"/>

    <!-- Network Statistics Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Network Statistics"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/md_theme_primary"/>

    <TextView
        android:id="@+id/statsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:textSize="14sp"/>

    <!-- Log File Button -->
    <Button
        android:id="@+id/viewLogButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Security Log"
        android:layout_marginTop="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="New messages will be marked 'Authenticating...' until the next TESLA key disclosure occurs."
        android:layout_marginTop="16dp"
        android:textStyle="italic"
        android:textSize="12sp"/>

</LinearLayout>